# Copy this file to .env.local (for local development) and also add these
# same three values in Vercel → Project → Settings → Environment Variables
# for the live site.
#
# Get them from https://www.sanity.io/manage after creating a project:
# Project ID and dataset name are shown on the project's overview page.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Both only needed once, to run the one-time content migration at
# /api/migrate?secret=... (see README → "Populating Sanity with your
# existing content"). Never commit these values.
SANITY_API_WRITE_TOKEN=
MIGRATE_SECRET=

# Powers instant content updates — the site refreshes the moment you
# publish in Sanity Studio, instead of waiting up to an hour (see README →
# "Setting up instant content updates"). Any random string you make up
# yourself — also add the exact same value as a custom header when you
# create the webhook in Sanity, and as an env var in Vercel.
SANITY_REVALIDATE_SECRET=

# Powers the "Customize Your Tour" form → email delivery via Resend
# (see README → "Setting up email delivery (Resend)"). Get the API key from
# resend.com/api-keys after creating an account and verifying a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Powers "Ask Egypt Eye", the AI concierge inside a signed-in customer's My
# Egypt portal (see README → "Setting up the AI concierge"), and the
# translation pipeline that fills the site's six non-English languages
# (README → "Languages"). Free — get a key at aistudio.google.com/apikey,
# no card required.
GEMINI_API_KEY=

# Powers customer accounts, the newsletter/4% discount system, and
# reservations (see README → "Setting up accounts, newsletter & discounts").
# Free — create a project at supabase.com, then Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, bypasses all security rules. Never expose this to
# the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in emails (verify/reset/unsubscribe links) and the sitemap.
# Set to your real domain in production (e.g. https://egypteyetravel.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Powers automatically pinning every blog Story to Pinterest (see
# /admin/pinterest and README → "Setting up the Pinterest integration").
# Create a Pinterest Business account, then a Developer App at
# developers.pinterest.com/apps to get these two values — add
# https://yourdomain.com/api/pinterest/oauth/callback as that app's redirect URI.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Any random string you make up yourself — also add the exact same value in
# Vercel. Vercel automatically sends it as a bearer token on the daily cron
# request (see vercel.json), which is what proves that request actually came
# from Vercel's own scheduler and not a random visitor hitting the URL.
CRON_SECRET=
# Only needed temporarily: a new Pinterest app starts on Trial access, which
# can only create Pins against Pinterest's sandbox API, not production. Set
# this to https://api-sandbox.pinterest.com/v5 to record the demo video
# Pinterest's Standard Access application requires, then remove it (or leave
# unset) once Standard Access is approved — unset defaults to production.
PINTEREST_API_BASE_URL=

# ---------------------------------------------------------------------------
# PayPal — deposits paid in the booking popup, without leaving the page.
#
# Create a REST API app at developer.paypal.com → Apps & Credentials. The page
# has a Sandbox/Live toggle and the two sets of keys are completely separate,
# so take the pair from whichever one you mean to use and set PAYPAL_ENV to
# match. A sandbox key against the live host (or the reverse) fails with an
# authentication error rather than doing something subtly wrong.
#
# With these unset the site still works: the booking flow falls back to the
# per-product PayPal payment links, and with none of those to a request with
# no payment. It never shows a broken checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (the default) or live. Anything unrecognised is treated as sandbox,
# deliberately — guessing wrong towards live spends real money.
PAYPAL_ENV=sandbox
# CAPTURE (the default) takes the deposit when the customer approves, which is
# what "instant payment" means and what the payment links already did.
# AUTHORIZE only holds it and a person captures it on confirming the date —
# tidier, but PayPal honours a hold for 3 days and allows capture up to 29,
# after which it can fail or come back short. The customer-facing wording
# follows this automatically: "paid, refunded if we cannot confirm" against
# CAPTURE, "held, not charged" against AUTHORIZE.
PAYPAL_INTENT=CAPTURE
# From developer.paypal.com → your app → Webhooks → Add Webhook, pointed at
# https://yourdomain.com/api/webhooks/paypal and subscribed to the
# PAYMENT.CAPTURE.* and PAYMENT.AUTHORIZATION.* events.
#
# Until this is set EVERY webhook is refused, because with no webhook id there
# is no way to tell a real PayPal delivery from anyone else POSTing to a
# public URL. Payments still work — the browser settles them — but anything
# that happens after the customer closes the tab (a reviewed payment clearing,
# a refund issued from the PayPal dashboard) will not reach the site.
PAYPAL_WEBHOOK_ID=
